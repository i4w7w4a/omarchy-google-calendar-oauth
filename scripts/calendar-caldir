#!/usr/bin/env python3
"""Run only the private, pinned Caldir installation; never use a shared profile."""
import os
from pathlib import Path
import sys
import tomllib
import signal
import subprocess
import tempfile
import ctypes
from calendar_goa import token_environment

config = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "omarchy-calendar"
data = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "omarchy-calendar"
binary = data / "bin/caldir"
profile = config / "caldir/config.toml"
try:
    for directory in (config, config / "caldir", config / "caldir/providers", config / "caldir/providers/google",
                      config / "caldir/providers/google/session", data, data / "bin", data / "calendars"):
        if directory.is_symlink() or not directory.is_absolute():
            raise ValueError("Refusing an unexpected private profile path")
    for executable in (binary, data / "bin/caldir-provider-google"):
        if not executable.is_file() or executable.is_symlink() or not os.access(executable, os.X_OK):
            raise ValueError("Caldir is not installed; run setup")
    if not profile.is_file() or profile.is_symlink():
        raise ValueError("The private Caldir profile is not configured; run setup")
    value = tomllib.loads(profile.read_text())
    if Path(value.get("calendar_dir", "")).expanduser().resolve() != (data / "calendars").resolve():
        raise ValueError("The private profile points outside its calendar directory")
    args = sys.argv[1:]
    fixed = (["--version"], ["config", "--json"], ["calendars", "--json"])
    allowed = args in fixed or (args[:2] == ["--json", "events"]) or (bool(args) and args[0] in {"new", "events", "pull", "push", "status"})
    if not allowed or "--force" in args:
        raise ValueError("This operation is not allowed by the private calendar wrapper")
    env = os.environ.copy()
    env.pop("CALDIR_PROVIDER_STORAGE_DIR", None)
    env["XDG_CONFIG_HOME"] = str(config)
    env["PATH"] = str(data / "bin") + ":/usr/bin:/bin"
    env["NO_COLOR"] = "1"
    os.umask(0o077)
    if args[0] in {"push", "pull", "status"}:
        def cancelled(signum, frame):
            raise InterruptedError("Calendar operation cancelled; remote result may be incomplete")
        signal.signal(signal.SIGTERM, cancelled)
        signal.signal(signal.SIGINT, cancelled)
        with token_environment(config, data, env) as child_env:
            runtime = Path(os.environ.get("XDG_RUNTIME_DIR", ""))
            if not runtime.is_absolute() or not runtime.is_dir():
                raise RuntimeError("A private user runtime directory is required")
            with tempfile.TemporaryDirectory(prefix="calendar-provider-", dir=runtime) as proxy_dir:
                if args[0] == "push":
                    plan = child_env.get("OMARCHY_CALENDAR_PUSH_PLAN", "")
                    if not Path(plan).is_absolute():
                        raise RuntimeError("A queued calendar push plan is required")
                    gate = Path(__file__).resolve().parent / "calendar-provider-gate"
                    if not gate.is_file() or gate.is_symlink() or not os.access(gate, os.X_OK):
                        raise RuntimeError("The calendar write guard is unavailable")
                    (Path(proxy_dir) / "caldir-provider-google").symlink_to(gate)
                    child_env["PATH"] = proxy_dir
                    child_env["OMARCHY_CALENDAR_REAL_GOOGLE_PROVIDER"] = str(data / "bin/caldir-provider-google")
                parent = os.getpid()
                def parent_death():
                    if ctypes.CDLL(None).prctl(1, signal.SIGKILL, 0, 0, 0) != 0 or os.getppid() != parent:
                        os._exit(125)
                process = subprocess.Popen([str(binary), "--timeout", "45s", *args], env=child_env,
                                           start_new_session=True, preexec_fn=parent_death)
                try:
                    code = process.wait(timeout=90)
                except subprocess.TimeoutExpired:
                    raise RuntimeError("Calendar operation timed out; remote result may be incomplete")
                finally:
                    if process.poll() is None:
                        os.killpg(process.pid, signal.SIGTERM)
                        try:
                            process.wait(timeout=2)
                        except subprocess.TimeoutExpired:
                            os.killpg(process.pid, signal.SIGKILL)
                            process.wait()
            raise SystemExit(code)
    else:
        os.execve(binary, [str(binary), *args], env)
except (OSError, ValueError, RuntimeError) as error:
    print(str(error), file=sys.stderr)
    raise SystemExit(1)
