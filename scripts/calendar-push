#!/usr/bin/env python3
"""Send either queued plugin edits or an explicitly confirmed Caldir push."""
import sys

from calendar_snapshot import refresh_cache
from calendar_store import CalendarError, calendar_lock, handle_error, json_output
from calendar_sync import push

args = sys.argv[1:]
structured = args in (["--auto"], ["--confirm", "--json"])
try:
    if args not in (["--auto"], ["--confirm"], ["--confirm", "--json"]):
        raise CalendarError("Usage: calendar-push --auto|--confirm [--json]", 64)
    with calendar_lock(wait=False):
        status, detail = push(automatic=args == ["--auto"])
        if status == "synced":
            try:
                refresh_cache()
            except (CalendarError, OSError, ValueError):
                pass
    if structured:
        json_output({"ok": True, "sync": status})
    elif detail:
        print(detail)
except (CalendarError, OSError, ValueError) as error:
    raise SystemExit(handle_error(error, structured, "pending"))
