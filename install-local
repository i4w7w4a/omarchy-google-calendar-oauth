#!/usr/bin/env python3
"""Install the reviewed local source and replace the stock central clock."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import time

ROOT=Path(__file__).resolve().parent
ID='re_pick.google-calendar-clock'
os.umask(0o077)
# Omarchy 4.5 keeps shell configuration under HOME regardless of XDG_CONFIG_HOME.
config=Path.home()/'.config/omarchy'
state=Path(os.environ.get('XDG_STATE_HOME',Path.home()/'.local/state'))
destination=config/'plugins'/ID
shell_file=config/'shell.json'
if destination.is_symlink() or shell_file.is_symlink():
    raise SystemExit('Refusing an unexpected configuration link')
in_place = ROOT.resolve() == destination.resolve()
if not in_place and (destination/'.git').exists():
    raise SystemExit('Update the existing Git checkout, then run its install-local in place')
subprocess.run(['omarchy','plugin','validate',str(ROOT)],check=True)
subprocess.run([str(ROOT/'setup'),'--binaries-only'],check=True)
original=shell_file.read_bytes() if shell_file.exists() else None
template=Path('/usr/share/omarchy/config/omarchy/shell.json')
value=json.loads(original if original is not None else template.read_bytes())
backups=state/'omarchy-project/backups'
backups.mkdir(mode=0o700,parents=True,exist_ok=True)
backup=Path(tempfile.mkdtemp(prefix=time.strftime('%Y%m%d-%H%M%S-calendar-install-'),dir=backups))
if original is not None:(backup/'shell.json').write_bytes(original)
else:(backup/'absent-shell.txt').write_text(str(shell_file)+'\n')
if destination.exists():shutil.copytree(destination,backup/ID,symlinks=True)
else:(backup/'absent-paths.txt').write_text(str(destination)+'\n')
bar=value.setdefault('bar',{})
layout=bar.setdefault('layout',{})
found=False
for section,entries in layout.items():
    for index,entry in enumerate(entries):
        normalized={'id':entry} if isinstance(entry,str) else entry
        if normalized.get('id') in ('omarchy.clock',ID):
            entries[index]={**normalized,'id':ID}
            entries[index].setdefault('calendarAutoPush',True)
            entries[index].setdefault('calendarPanelPosition','original')
            found=True
if not found:layout.setdefault('center',[]).insert(0,{'id':ID,'calendarAutoPush':True,'calendarPanelPosition':'original'})
bar['centerAnchor']=ID
value['disabledPlugins']=[item for item in value.get('disabledPlugins',[]) if item!=ID]
if 'omarchy.clock' not in value['disabledPlugins']:value['disabledPlugins'].append('omarchy.clock')
if not in_place:
    with tempfile.TemporaryDirectory(prefix='calendar-stage-',dir=state) as temporary:
        staged=Path(temporary)/ID
        shutil.copytree(ROOT,staged,ignore=shutil.ignore_patterns('.git','__pycache__','*.pyc'))
        if (shell_file.read_bytes() if shell_file.exists() else None)!=original:raise SystemExit('Shell configuration changed; retry installation')
        if destination.exists():shutil.rmtree(destination)
        destination.parent.mkdir(parents=True,exist_ok=True)
        shutil.move(str(staged),str(destination))
if (shell_file.read_bytes() if shell_file.exists() else None)!=original:raise SystemExit('Shell configuration changed; retry installation')
shell_file.parent.mkdir(parents=True,exist_ok=True)
with tempfile.NamedTemporaryFile('w',dir=shell_file.parent,delete=False) as output:
    json.dump(value,output,ensure_ascii=False,indent=2);output.write('\n');replacement=Path(output.name)
replacement.chmod(shell_file.stat().st_mode & 0o777 if shell_file.exists() else 0o600)
replacement.replace(shell_file)
subprocess.run(['omarchy','shell','shell','rescanPlugins'],check=True,stdout=subprocess.DEVNULL)
subprocess.run(['omarchy','shell','shell','reloadConfig'],check=True,stdout=subprocess.DEVNULL)
print('Google Calendar установлен. Резервная копия:',backup)
