+fn insert_url(mut base: Url, calendar_id: &str) -> Result<Url> {
+    if matches!(calendar_id, "" | "." | "..") {
+        bail!("Invalid Google calendar ID");
     }
+    base.path_segments_mut()
+        .map_err(|_| anyhow::anyhow!("Invalid Calendar API URL"))?
+        .pop_if_empty()
+        .extend(["calendars", calendar_id, "events"]);
+    base.query_pairs_mut()
+        .append_pair("conferenceDataVersion", "1")
+        .append_pair("sendUpdates", "all");
+    Ok(base)
+}
+
+async fn insert_once(url: Url, token: &str, event: &Event) -> Result<Event> {
+    // Preserve Caldir's iCalUID. The SDK retries POST even when it was accepted.
+    let mut body = event.to_google();
+    body.id.clear();
+    let client = Client::builder()
+        .retry(reqwest::retry::never())
+        .redirect(reqwest::redirect::Policy::none())
+        .no_proxy()
+        .build()?;
+    let request = client
+        .post(url)
+        .bearer_auth(token)
+        .header(reqwest::header::ACCEPT, "application/json")
+        .json(&body)
+        .build()?;
+    let response = client.execute(request).await.context(UNKNOWN_RESULT)?;
+    let status = response.status();
+    if matches!(
+        status.as_u16(),
+        400 | 401 | 403 | 404 | 405 | 410 | 413 | 415 | 422 | 429
+    ) {
+        bail!("Google rejected event creation (HTTP {})", status.as_u16());
+    }
+    if !status.is_success() {
+        bail!("{UNKNOWN_RESULT} (HTTP {})", status.as_u16());
+    }
+    let created: google_calendar::types::Event = response.json().await.context(UNKNOWN_RESULT)?;
+    if created.id.is_empty() || created.i_cal_uid != event.uid.as_str() {
+        bail!("{UNKNOWN_RESULT} (unexpected event identity)");
+    }
+    Event::from_google(created).context(UNKNOWN_RESULT)
 }
 
